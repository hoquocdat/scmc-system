{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^uuid$": "<rootDir>/test/integration/uuid-shim.ts"
  },
  "setupFiles": ["<rootDir>/test/integration/setup-env.ts"],
  "testTimeout": 60000,
  "maxWorkers": 1
}
